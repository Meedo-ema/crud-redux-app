* {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

body {
  background-color: #f6f6f6;
  text-align: center;
}

.form {
  width: 100%;
  padding: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 10px;
}

.form-inputs {
  width: 100%;
  max-width: 800px;
  display: flex;
  justify-content: space-around;
}

h1,
h2,
button {
  font-family: 'Courier New', Courier, monospace;
}

h1 {
  margin-bottom: 20px;
  background-color: #000;
  color: #fff;
  padding: 10px;
}

.form input,
.form button {
  width: 200px;
  height: 40px;
  border: 1px solid #888;
  border-radius: 5px;
  margin: 2px;
  padding: 5px;
}

button {
  font-size: 12px;
  font-weight: bold;
  cursor: pointer;
}

.post {
  background-color: #fff;
  width: 80%;
  border: 1px solid #666;
  border-radius: 5px;
  margin: 10px auto;
  padding: 10px;
}

.post button {
  width: 150px;
  margin: 5px;
  display: inline-block;
}

@media (max-width: 600px) {
  .form {
    padding: 15px 10px;
  }

  .form-inputs {
    flex-direction: column;
    align-items: center;
  }

  .form input,
  .form button {
    width: 100%;
    max-width: 350px;
  }

  .post {
    width: 95%;
  }

  .post button {
    width: 100%;
    max-width: 250px;
  }
}
